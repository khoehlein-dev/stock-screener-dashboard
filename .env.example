# Massive API key (https://massive.com/dashboard). Leave empty to use the synthetic provider.
SCREENER_MASSIVE_API_KEY=
# Comma-separated universe or path to a CSV/TXT file with one ticker per line
SCREENER_UNIVERSE=AAPL,MSFT,NVDA,AMZN,GOOGL,META,TSLA,JPM,XOM,UNH
# Entitlements
SCREENER_HAS_FUNDAMENTALS=true
SCREENER_HAS_INDICES=false
# Flat risk-free rate used for option pricing (continuous compounding)
SCREENER_RISK_FREE_RATE=0.04
# Where parquet caches and the screener table are stored
SCREENER_DATA_DIR=./data
